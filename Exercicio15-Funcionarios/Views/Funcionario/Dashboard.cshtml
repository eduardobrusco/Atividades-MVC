@model List<FuncionariosMVC.Models.Funcionario>@{var media=Model.Average(f=>f.Salario);}<h1>Dashboard</h1><div class='grid'><div class='card'>Total: @Model.Count</div><div class='card'>Ativos: @Model.Count(f=>f.Ativo)</div><div class='card'>Inativos: @Model.Count(f=>!f.Ativo)</div><div class='card'>Média salarial: R$ @media.ToString("N2")</div><div class='card'>Maior salário: R$ @Model.Max(f=>f.Salario).ToString("N2")</div><div class='card'>Menor salário: R$ @Model.Min(f=>f.Salario).ToString("N2")</div></div><h2>Quantidade por departamento</h2><table><tr><th>Departamento</th><th>Quantidade</th></tr>@foreach(var g in Model.GroupBy(f=>f.Departamento).OrderBy(g=>g.Key)){<tr><td>@g.Key</td><td>@g.Count()</td></tr>}</table>
