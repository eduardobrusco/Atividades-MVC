@model List<CursosMVC.Models.Curso><h1>Sistema de Cursos</h1><div class='grid'><div class='card'>Total: @Model.Count</div><div class='card'>Disponíveis: @Model.Count(c=>c.Vagas>0)</div><div class='card'>Lotados: @Model.Count(c=>c.Vagas==0)</div><div class='card'>Online: @Model.Count(c=>c.Modalidade=="Online")</div><div class='card'>Presenciais: @Model.Count(c=>c.Modalidade=="Presencial")</div></div><table><tr><th>Curso</th><th>Carga</th><th>Modalidade</th><th>Vagas</th><th>Valor</th><th>Situação</th></tr>@foreach(var c in Model){<tr><td>@c.Nome</td><td>@c.CargaHoraria h</td><td>@c.Modalidade</td><td>@c.Vagas</td><td>R$ @c.Valor.ToString("N2")</td><td>@(c.Vagas>0?"Inscrições abertas":"Turma lotada")</td></tr>}</table>
