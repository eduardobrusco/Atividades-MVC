@model List<PedidosMVC.Models.Pedido>@{var total=Model.Sum(p=>p.Quantidade*p.PrecoUnitario);}<h1>Resumo</h1><div class='grid'><div class='card'>Total de pedidos: @Model.Count</div><div class='card'>Valor total: R$ @total.ToString("N2")</div><div class='card'>Recebidos: @Model.Count(p=>p.Status=="Recebido")</div><div class='card'>Em preparo: @Model.Count(p=>p.Status=="Em preparo")</div><div class='card'>Prontos: @Model.Count(p=>p.Status=="Pronto")</div><div class='card'>Entregues: @Model.Count(p=>p.Status=="Entregue")</div></div>
