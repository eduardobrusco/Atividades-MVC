@model List<PedidosMVC.Models.Pedido><h1>Pedidos</h1><table><tr><th>ID</th><th>Cliente</th><th>Produto</th><th>Qtd.</th><th>Unitário</th><th>Total</th><th>Status</th></tr>@foreach(var p in Model){<tr><td>@p.Id</td><td>@p.Cliente</td><td>@p.Produto</td><td>@p.Quantidade</td><td>R$ @p.PrecoUnitario.ToString("N2")</td><td>R$ @((p.Quantidade*p.PrecoUnitario).ToString("N2"))</td><td>@p.Status</td></tr>}</table>
