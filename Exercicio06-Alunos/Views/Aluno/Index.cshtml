@model List<AlunosMVC.Models.Aluno><h1>Cadastro de Alunos</h1><table><tr><th>ID</th><th>Nome</th><th>Idade</th><th>Curso</th><th></th></tr>@foreach(var a in Model){<tr><td>@a.Id</td><td>@a.Nome</td><td>@a.Idade</td><td>@a.Curso</td><td><a href="@Url.Action("Detalhes","Aluno",new{id=a.Id})">Detalhes</a></td></tr>}</table>
